+import type { Reading, ReadingDetail } from '../../../core/air';
+import {
+  DEFAULT_SETTINGS,
+  type Settings,
+  type SettingsStore,
+} from '../../../core/settings';
+
+const store = (s: Settings = DEFAULT_SETTINGS): SettingsStore => ({
+  load: async () => s,
+  save: async () => {},
+});
+
+const READING: Reading = {
+  index: 63,
+  pm25: 65,
+  measuredAt: '2026-08-15 12:00:00',
+  city: 'Kraków',
+  station: 'Aleja Krasińskiego',
